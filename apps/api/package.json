{
  "name": "@humans/api",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "wrangler deploy --dry-run --env='' --outdir dist",
    "deploy:preview": "node scripts/deploy-with-sentry.mjs preview humans-preview",
    "deploy:production": "node scripts/deploy-with-sentry.mjs production humans",
    "dev": "wrangler dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check-types": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "3.17.0",
    "@hono/zod-openapi": "1.6.1",
    "@humans/database": "*",
    "@humans/polar-billing": "*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@sentry/cloudflare": "10.73.0",
    "@scalar/hono-api-reference": "0.12.0",
    "effect": "4.0.0-rc.112",
    "hono": "4.13.5",
    "standardwebhooks": "1.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@sentry/cli": "2.58.6",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.3.0",
    "@types/pg": "8.23.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-orm": "0.45.2",
    "pg": "8.23.0",
    "typescript": "6.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
