{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "humans-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "ratelimits": [
    {
      "name": "ORGANIZATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "NATURAL_SEARCH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "env": {
    "preview": {
      "name": "humans-api-preview",
      "ratelimits": [
        {
          "name": "ORGANIZATION_RATE_LIMITER",
          "namespace_id": "1101",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "NATURAL_SEARCH_RATE_LIMITER",
          "namespace_id": "1102",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "humans-api-production",
      "ratelimits": [
        {
          "name": "ORGANIZATION_RATE_LIMITER",
          "namespace_id": "1201",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "NATURAL_SEARCH_RATE_LIMITER",
          "namespace_id": "1202",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
