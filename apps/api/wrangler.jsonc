{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "humans-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "placement": { "mode": "smart" },
  "ratelimits": [
    {
      "name": "ORGANIZATION_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "MEMBER_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "API_KEY_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "IP_RATE_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "NATURAL_SEARCH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "env": {
    "preview": {
      "name": "humans-api-preview",
      "ratelimits": [
        {
          "name": "ORGANIZATION_RATE_LIMITER",
          "namespace_id": "1101",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "MEMBER_RATE_LIMITER",
          "namespace_id": "1103",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "API_KEY_RATE_LIMITER",
          "namespace_id": "1104",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "1105",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "NATURAL_SEARCH_RATE_LIMITER",
          "namespace_id": "1102",
          "simple": { "limit": 10, "period": 60 }
        }
      ]
    },
    "production": {
      "name": "humans-api-production",
      "ratelimits": [
        {
          "name": "ORGANIZATION_RATE_LIMITER",
          "namespace_id": "1201",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "MEMBER_RATE_LIMITER",
          "namespace_id": "1203",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "API_KEY_RATE_LIMITER",
          "namespace_id": "1204",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "IP_RATE_LIMITER",
          "namespace_id": "1205",
          "simple": { "limit": 120, "period": 60 }
        },
        {
          "name": "NATURAL_SEARCH_RATE_LIMITER",
          "namespace_id": "1202",
          "simple": { "limit": 10, "period": 60 }
        }
      ]
    }
  }
}
