NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Defaults to http://localhost:8787.
# HUMANS_API_URL=https://api.example.com
HUMANS_PROXY_SECRET=replace-with-a-shared-random-secret

# Optional. Enables privacy-restricted server and browser error reporting.
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=local

# Preview browser acceptance only. Map the Preview publishable key to
# CLERK_PUBLISHABLE_KEY for @clerk/testing; never use Production test mode.
# PLAYWRIGHT_PREVIEW_URL=https://preview.example.com
# PLAYWRIGHT_PRODUCTION_URL=https://humans.example.com
# CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# E2E_PROFILE_QUERY=known-sanitized-profile-query
# E2E_PROFILE_OWNER_IMPERSONATION_URL=short-lived-production-url
# VERCEL_AUTOMATION_BYPASS_SECRET=replace-with-preview-bypass-secret
