{
  "name": "humans",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@humans/api",
    "dev:trigger": "bun run --cwd packages/tasks dev",
    "dev:web": "turbo run dev --filter=web",
    "deploy:trigger": "bun run --cwd packages/tasks deploy:trigger",
    "deploy:trigger:dry-run": "bun run --cwd packages/tasks deploy:trigger:dry-run",
    "deploy:trigger:preview": "bun run --cwd packages/tasks deploy:preview",
    "deploy:trigger:preview:dry-run": "bun run --cwd packages/tasks deploy:preview:dry-run",
    "deploy:trigger:production": "bun run --cwd packages/tasks deploy:production",
    "deploy:trigger:production:dry-run": "bun run --cwd packages/tasks deploy:production:dry-run",
    "deploy:api:preview": "bun run --cwd apps/api deploy:preview",
    "deploy:api:production": "bun run --cwd apps/api deploy:production",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "turbo": "^2.10.12",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
