{
  "name": "humans",
  "private": true,
  "overrides": {
    "@opentelemetry/core": "2.11.0",
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.2",
    "tar": "7.5.22",
    "ws": "8.21.0"
  },
  "scripts": {
    "accept:web:preview": "bun run --cwd apps/web accept:preview",
    "accept:web:production": "bun run --cwd apps/web accept:production",
    "configure:api:preview-origin": "bun run --cwd apps/web configure:preview-origin",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@humans/api",
    "dev:trigger": "bun run --cwd packages/tasks dev",
    "dev:web": "turbo run dev --filter=web",
    "deploy:trigger:preview": "bun run --cwd packages/tasks deploy:preview",
    "deploy:trigger:preview:dry-run": "bun run --cwd packages/tasks deploy:preview:dry-run",
    "deploy:trigger:production": "bun run --cwd packages/tasks deploy:production",
    "deploy:trigger:production:dry-run": "bun run --cwd packages/tasks deploy:production:dry-run",
    "deploy:api:preview": "bun run --cwd apps/api deploy:preview",
    "deploy:api:production": "bun run --cwd apps/api deploy:production",
    "deploy:web:preview": "bun run --cwd apps/web deploy:preview",
    "deploy:web:production:stage": "bun run --cwd apps/web deploy:production:stage",
    "deploy:web:production:promote": "bun run --cwd apps/web deploy:production:promote",
    "verify:web:preview": "bun run --cwd apps/web verify:preview",
    "verify:web:production": "bun run --cwd apps/web verify:production",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:browser": "bun run --cwd apps/web test:browser"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
