{
  "name": "@humans/tasks",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./trigger": "./src/trigger/index.ts"
  },
  "scripts": {
    "dev": "trigger dev",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:preview:dry-run": "node scripts/deploy.mjs preview --dry-run",
    "deploy:production": "node scripts/deploy.mjs production",
    "deploy:production:dry-run": "node scripts/deploy.mjs production --dry-run",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check-types": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "tikhub:run": "bun ./scripts/run-tikhub.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@humans/database": "*",
    "@humans/deepline-enrichment": "*",
    "@humans/github-enrichment": "*",
    "@humans/polar-billing": "*",
    "@humans/tikhub-enrichment": "*",
    "@sentry/node": "10.73.0",
    "@trigger.dev/sdk": "4.5.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@repo/typescript-config": "*",
    "@trigger.dev/build": "4.5.16",
    "@types/node": "26.4.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "trigger.dev": "4.5.16",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
