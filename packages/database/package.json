{
  "name": "@humans/database",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/service/index.ts",
    "./import-profiles": "./src/import-profiles.ts",
    "./profile-control": "./src/profile-control.ts",
    "./professional-links": "./src/professional-links.ts",
    "./credits": "./src/credits.ts",
    "./contact-reveals": "./src/contact-reveals.ts",
    "./charged-search": "./src/charged-search.ts",
    "./abuse-controls": "./src/abuse-controls.ts",
    "./billing": "./src/billing.ts",
    "./companies": "./src/companies.ts",
    "./enrichment": "./src/enrichment.ts",
    "./operations": "./src/operations.ts",
    "./neon": "./src/neon.ts",
    "./search-profiles": "./src/search-profiles.ts",
    "./saved-lists": "./src/saved-lists.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "node ./scripts/generate-migrations.mjs",
    "db:migrate": "drizzle-kit migrate",
    "db:rehearse": "vitest run test/migration-rehearsal.test.ts",
    "companies:backfill": "bun ./src/backfill-companies-cli.ts",
    "profiles:import": "bun ./src/import-profiles-cli.ts",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check-types": "node ../../node_modules/@typescript/native/bin/tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.10",
    "pg": "8.23.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
