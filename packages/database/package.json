{
  "name": "@humans/database",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/service.ts",
    "./neon": "./src/neon.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "node ./scripts/generate-migrations.mjs",
    "db:migrate": "drizzle-kit migrate",
    "lint": "eslint . --max-warnings 0",
    "check-types": "node ../../node_modules/@typescript/native/bin/tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/node": "26.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "typescript": "6.0.2"
  }
}
